{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/save_prompt.py\"",
            "timeout": 10,
            "statusMessage": "Saving prompt to docs/prompts"
          }
        ]
      }
    ]
  }
}
